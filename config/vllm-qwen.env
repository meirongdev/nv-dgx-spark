# vLLM Configuration for DGX Spark (GB10 Blackwell)
# Used by: playbooks/vllm-qwen-deploy.yml, scripts/run-vllm-qwen.sh, Makefile
VLLM_MODEL=bjk110/Qwen3.5-122B-A10B-abliterated-NVFP4
VLLM_SERVED_NAME=Qwen3.5-122B-A10B
VLLM_IMAGE=vllm-node-tf5:latest
VLLM_PORT=30000
VLLM_GPU_MEM=0.70
VLLM_KV_DTYPE=fp8_e4m3
VLLM_TOOL_PARSER=qwen3_coder
VLLM_REASONING_PARSER=qwen3
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_NUM_SEQS=64
