# DeepSeek-V4-Flash dual-node TP=2 vLLM — boot autostart unit.
#
# Installed on the HEAD node (192.168.200.101 / 100.97.87.120) as
#   /etc/systemd/system/deepseek-v4-flash.service
# via `make v4flash-autostart`. Runs as `admin` (in the docker group, with
# passwordless SSH to the worker). The head's launch-cluster.sh drives the TP
# worker over SSH, so the worker needs no unit of its own.
#
# Manage:  sudo systemctl {start,stop,status} deepseek-v4-flash
#          journalctl -u deepseek-v4-flash -f
#          make v4flash-autostart-status   (from the repo, over SSH)

[Unit]
Description=DeepSeek-V4-Flash dual-node TP=2 vLLM (eugr harness, jasl/vllm fork)
Documentation=file:///home/admin/spark-vllm-docker/README.md
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
# Keep retrying across a simultaneous-reboot race with the worker — don't let
# the default start-rate limiter give up while the worker is still booting.
StartLimitIntervalSec=0

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/spark-vllm-docker
Environment=HOME=/home/admin
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Worker has no foreign-net proxy → load weights fully offline.
Environment=DOTENV_CONTAINER_HF_HUB_OFFLINE=1
Environment=DOTENV_CONTAINER_TRANSFORMERS_OFFLINE=1
# Tunables (override with: sudo systemctl edit deepseek-v4-flash).
Environment=DSV4_HARNESS=/home/admin/spark-vllm-docker
Environment=DSV4_WORKER=192.168.200.102
Environment=DSV4_CONTAINER=vllm_node
Environment=DSV4_RECIPE=deepseek-v4-flash
Environment=DSV4_WAIT_TIMEOUT=900

ExecStart=/home/admin/v4flash-boot.sh
ExecStop=/home/admin/v4flash-boot.sh stop

# vLLM weight load + warmup is slow; never time the start/stop out.
TimeoutStartSec=infinity
TimeoutStopSec=120
# Free crash-recovery too: relaunch the full orchestration if vLLM dies.
Restart=on-failure
RestartSec=30
# ExecStop does the real teardown (removes the --rm containers on both nodes);
# mixed also reaps the local docker-exec client and any stragglers.
KillMode=mixed

[Install]
WantedBy=multi-user.target
