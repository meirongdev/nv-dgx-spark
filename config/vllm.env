# vLLM Environment Configuration for DGX Spark (GB10, Blackwell sm_121)
# Updated: April 2026 - Best practices for unified memory architecture

# ========================================
# Attention Backend (FlashInfer - REQUIRED)
# ========================================
VLLM_ATTENTION_BACKEND=FLASHINFER
VLLM_USE_FLASHINFER_MOE_FP8=1
VLLM_FLASHINFER_MOE_BACKEND=latency

# ========================================
# CUDA & GPU Configuration
# ========================================
CUDA_VISIBLE_DEVICES=0
TORCH_CUDA_ARCH_LIST=12.1a
TRITON_PTXAS_PATH=/usr/local/cuda/bin/ptxas

# ========================================
# NCCL (Multi-node - disable for single node)
# ========================================
NCCL_P2P_DISABLE=0
NCCL_SOCKET_IFNAME=enp1s0f0np0
NCCL_IB_DISABLE=1

# ========================================
# vLLM Memory Management (Critical for 128GB unified memory)
# ========================================
# DO NOT set above 0.7 - unified memory needs headroom for fragmentation
VLLM_GPU_MEMORY_UTILIZATION=0.7
VLLM_KV_CACHE_DTYPE=fp8

# ========================================
# Model Configuration
# ========================================
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_MAX_MODEL_LEN=32768
VLLM_DTYPE=auto
VLLM_TENSOR_PARALLEL_SIZE=1

# ========================================
# Performance Tuning
# ========================================
VLLM_MAX_NUM_SEQS=128
VLLM_MAX_NUM_BATCHED_TOKENS=8192

# ========================================
# Optional: Trust remote code (for custom models)
# ========================================
VLLM_TRUST_REMOTE_CODE=true

# ========================================
# Logging & Monitoring
# ========================================
VLLM_LOGGING_LEVEL=INFO
VLLM_PROMETHEUS_PORT=8001
