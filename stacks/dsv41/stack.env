# DeepSeek-V4.1-Flash-1017 EXL3 2.9 bpw (Mia EAQ v1) —— 上游 MiaAI-Lab 双机 recipe,TensorFold 原生 Zig 引擎,
# TP=2 横跨 S1+S2(rank0 + API 在 S1,rank1 在 S2)。
#
# 上游:MiaAI-Lab/DeepSeek-v4.1-Flash-1017-2x-DGX-Sparks @ c7f2b85(2026-11-09),原样放在
# S1 的 /home/admin/dsv41-recipe;本地偏离只在 scripts/local.sh(= stacks/dsv41/local.sh):
# WORKER / PORT=8000 / CONTEXT=262144(11-15 由 524288 改小) / PATH 补 ~/.local/bin。为什么:recipe.yaml。
#
# ⚠️ TP=2 的全部规矩适用:绝不单独重启一个 rank(gotcha #1)。上游 ./start.sh restart 与
#    ./stop.sh 都成对动两台;"一个 rank 退出会把另一个也带走"是上游 FOREGROUND 模式的设计。
# ⚠️ 上游自带 memguard(两台各一个,MemAvailable < 2.5 GiB 持续 4 s 或 < 1 GiB 立即 kill
#    本 rank 的容器)。本仓库的 dgx-memwatch 是它之外的第二道,见下面阈值注释。

STACK_ID=dsv41
STACK_NAME="DeepSeek-V4.1-Flash-1017 EXL3 2.9bpw 双机 TP=2 (MiaAI-Lab recipe, TensorFold Zig, DSpark 草稿)"
STACK_STATUS="primary (2026-11-14 起) —— 占两台 TP=2"
STACK_ENGINE=tensorfold-zig
STACK_RUNTIME=docker
STACK_NODES=2
STACK_HEAD=100.97.87.120
# ⚠️ TP=2:rank1 吃 S2 的 GPU(~98 GiB 权重 / 台)—— 两台都要写(gotcha #2)。
STACK_GPU_NODES="100.97.87.120 100.67.164.92"
# :8000 —— 2026-11-14 用户选定(沿用旧主力端口,客户端只改模型名 + thinking 参数)。
STACK_PORT=8000
STACK_MODEL=DeepSeek-V4.1-Flash-1017

# --- thinking 语义(2026-11-14 对着活端点实测;make test STACK=dsv41 全过) ---
# 默认**开**思考(上游 THINKING=1)。只有 chat_template_kwargs.enable_thinking 生效:on/不传 184 chars CoT,
# off 0 chars、2 token 直接答 22;**顶层 enable_thinking=false 被静默忽略**(仍 184 chars)。
# CoT 在 `reasoning_content`,`reasoning` 恒空 —— 与 Qwen 主力(hibrid48tp2v52 回 `reasoning`)**相反**(gotcha #9)。
# /v1/responses:none / minimal / low / medium / high / xhigh / max 全 200;none 无 reasoning item。
# ⚠️ temperature 0 下 low / medium / high / xhigh 的推理**逐 token 相同**(58 reasoning tokens),只有 max 不同
#    (106)—— 档位里真正有区别的只有 none(关)和 max(多想)。上游模板只认 "low"|"high"|"max" 或 1..100。
STACK_THINK_KWARG=enable_thinking
STACK_THINK_OFF='{"chat_template_kwargs": {"enable_thinking": false}}'
STACK_COT_FIELD=reasoning_content
STACK_THINK_CAN_DISABLE=1
STACK_EFFORT_KWARG=reasoning_effort
STACK_EFFORT_LEVELS="low medium high xhigh max"

# --- 运行时(adapter-docker.sh 读这些) ---
# 两台同一个容器名 dsv41-1017-exl3-tf。start.sh 自己 ssh 到 worker(admin@192.168.200.102)起 rank1。
STACK_DIR=/home/admin/dsv41-recipe
STACK_CONTAINERS="dsv41-1017-exl3-tf"
STACK_WORKER_CONTAINER=dsv41-1017-exl3-tf
STACK_WORKER_IP=192.168.200.102
STACK_START_CMD="bash /home/admin/dsv41-launch.sh"
STACK_STOP_CMD="cd /home/admin/dsv41-recipe && ./stop.sh"
STACK_TMUX=1
STACK_LOAD_TIME="~31 s 加载(2026-11-14,rank 权重文件刚写完、在页缓存里);冷启动未测"

# --- 资产(preflight 用) ---
# 两台都有完整 checkpoint:S2 是 ModelScope 下载点(fetch-weights.sh,逐片 sha256 对 HF 45ee5d0f),
# S1 是从 S2 走 200G 拷来的(prepare.sh 让 S2 经 NFS 读 S1 这份)。39 片。
STACK_WEIGHTS=/home/admin/.cache/huggingface/hub/models--Mia-AiLab--DeepSeek-V4.1-Flash-1017-EXL3-EAQ-v1-2.9-bpw/snapshots/45ee5d0fd106c94a3d77f721e09cbb2f50e5a16b
STACK_WEIGHTS_SHARDS=39
# 本地构建(prepare.sh:zig/Dockerfile,两次 Zig 编译),tag 后缀 = 上游 image_hash()(patches + Dockerfile +
# 引擎/输入/zig/base 钉子的 sha256 前 12 位)。上游 ghcr 上只有旧 hash 7c9bf5d36350 的镜像,对不上这次的钉子。
# base nvcr.io/nvidia/pytorch:26.07-py3 来自 nvcr.nju.edu.cn(image ID 15b8de8b… = NGC arm64 config digest)。
STACK_IMAGE=tensorfold-dsv41:exl3-tp2-8a98ae503d85
STACK_ASSET_NODES="100.97.87.120 100.67.164.92"

# --- 内存看门狗 ---
# ⏳ 阈值待上线后按实测余量定。先沿用 hibrid48tp2v52 的 5 / 2 ×10 作占位;上游 memguard 的
#   硬线 2.5 GiB ≈ 2.05%,所以 crit=2% 在它之后才可能触发 —— 本看门狗是 memguard 挂掉时的兜底。
STACK_MEMWATCH_NODES="100.97.87.120 100.67.164.92"
STACK_MEMWATCH_STOP="./stop.sh"
STACK_MEMWATCH_WARN_PCT=5
STACK_MEMWATCH_CRIT_PCT=2
STACK_MEMWATCH_CRIT_CONSEC=10

# --- 客户端 / 文档 ---
STACK_CLIENT_ALIAS=dsv41
STACK_CTXWIN=262144
