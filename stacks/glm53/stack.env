# GLM-5.3-Flash EXL3 4bpw —— 跑上游 MiaAI-Lab 的 start.sh,docker,不在 k3s 里
STACK_ID=glm53
STACK_NAME="GLM-5.3-Flash EXL3 4bpw"
STACK_STATUS="rollback #2 —— 850K ctx"
STACK_ENGINE=vllm-exl3
STACK_RUNTIME=docker
STACK_NODES=2
STACK_HEAD=100.97.87.120
STACK_PORT=8888
STACK_MODEL=GLM-5.3-Flash-EXL3

# --- 思考语义:**第三套**,与其它四栈都不同 ---------------------------------
# ⚠️ 本栈**关不掉思考**,最低只能 reasoning_effort=low(medium 会被模板拒绝),
#    不传时渲染成 Max 并把 token 预算吃光。CoT 回在 `reasoning`,**不是**
#    `reasoning_content` —— 读错字段的表现是「一个字都没有」,与「思考没生效」同形。
STACK_THINK_KWARG=reasoning_effort
STACK_THINK_OFF='{"reasoning_effort":"low"}'   # 注意:是「最低档」,不是「关」
STACK_COT_FIELD=reasoning

STACK_DIR=/home/admin/glm53-exl3
STACK_CONTAINERS="glm53-exl3-head"
STACK_WORKER_CONTAINER=glm53-exl3-worker
STACK_WORKER_IP=192.168.200.102    # 200G 内网线,从 head 跳过去看 rank1 日志
# ⚠️⚠️ SKIP_BUILD=1 是硬性的。漏掉它 → ensure_image() 认为配方戳不符 →
#    在 S1 上跑源码构建 → head 节点 OOM(2026-07-04 实际发生过)。
#    而那两个戳**永远不可能相等**(overlay_recipe_hash 把绝对路径喂给 sha256sum),
#    它打印的 `stamp X != repo Y` 是恒定噪声,不是信号。详见 recipe.yaml。
STACK_START_CMD="cd /home/admin/glm53-exl3 && SKIP_BUILD=1 ./start.sh"
STACK_STOP_CMD="cd /home/admin/glm53-exl3 && ./start.sh stop"
STACK_STATUS_CMD="cd /home/admin/glm53-exl3 && ./start.sh status"
STACK_TMUX=1
STACK_LOAD_TIME="约 5 分钟"

STACK_WEIGHTS=/home/admin/.cache/huggingface/hub/models--Mia-AiLab--GLM-5.3-Flash-EXL3-TR3-4bpw/snapshots/25a44fdbf16862a46b7cc9921142c6c81350af2f
STACK_WEIGHTS_SHARDS=120
STACK_IMAGE=ghcr.nju.edu.cn/miaai-lab/glm-5.3-flash-2x-dgx-sparks:exl3-instanttensor
STACK_ASSET_NODES="100.97.87.120 100.67.164.92"

# ⚠️ 本栈主机 headroom 只有 1.8-2.0%,低于 memwatch 的 CRIT 5% —— 看门狗**跑不了**
#    (一启动就触发)。这不是配置问题,是这套配方在这台 UMA 上的真实状态,
#    要靠 --kv-cache-memory-bytes 降上下文换回来。详见 recipe.yaml。
STACK_MEMWATCH_NODES="100.97.87.120 100.67.164.92"
STACK_MEMWATCH_STOP="./start.sh stop"

STACK_CTXWIN=850000
STACK_CLIENT_ALIAS=glm53
STACK_BENCH=benchmarks/glm53-2026-09-19

# ⚠️ 本栈**无法关闭思考**,STACK_THINK_OFF 给的是最低档而不是"关"。
#    不声明这一条的话,生成出来的跨栈对照表会让人以为它和别的栈一样能关 ——
#    而那正是 2026-08-15 那次"CoT 读到 None 被误判成 parser 不匹配"的土壤。
STACK_THINK_CAN_DISABLE=0
