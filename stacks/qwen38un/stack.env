# Qwen3.8-27B-Uncensored NVFP4 + SGLang + DFlash2 —— 单节点(只用 S1)
# 本文件是**机器可读的栈身份**:所有工具(make / memwatch / clock-cap /
# 客户端切换 / 文档表格)都从这里读,不再各自持有默认值。
# 「为什么是这些参数」在 recipe.yaml 里,不在这里。

STACK_ID=qwen38un
STACK_NAME="Qwen3.8-27B-Uncensored NVFP4 + SGLang + DFlash2"
STACK_STATUS="primary (2026-09-19 起)"
STACK_ENGINE=sglang
STACK_RUNTIME=docker
STACK_NODES=1                      # ⚠️ 本仓库第一个单节点主力栈
STACK_HEAD=100.97.87.120
# 本栈吃哪些节点的 GPU 内存 —— preflight 的互斥判据(按节点相交,不是全表互斥)。
# 只占 S1,所以它和 S2 上的 fndgx 可以并存;2026-09-20 起两者确实在同时跑。
STACK_GPU_NODES="100.97.87.120"
STACK_PORT=8888
STACK_MODEL=qwen3.8-27b-sglang     # served-model-name = 栈的真正身份

# --- 思考语义(gotcha #9:这三行写错**不会报错**,只会静默返回错的结果)------
STACK_THINK_KWARG=enable_thinking
STACK_THINK_OFF='{"enable_thinking": false}'
STACK_COT_FIELD=reasoning_content  # ⚠️ 不是 reasoning —— GLM 那栈才是 reasoning

# --- 运行时(docker 适配器读这几行)-----------------------------------------
STACK_DIR=/home/admin/qwen38-sglang
STACK_CONTAINERS="qwen3.8-27b-sglang"
STACK_START_CMD="bash /home/admin/qwen38un-launch.sh"   # ← stacks/qwen38un/launch.sh,由适配器 scp
STACK_STOP_CMD="cd /home/admin/qwen38-sglang && ./stop.sh"
STACK_TMUX=1                       # 长时编排器 + DERP 中继会掉线 → 必须 tmux
STACK_LOAD_TIME="约 3 分钟"

# --- 资产(preflight 用)-----------------------------------------------------
STACK_WEIGHTS=/home/admin/qwen38-sglang/.cache/huggingface/local/Qwen3.8-27B-Uncensored-NVFP4
STACK_WEIGHTS_SHARDS=6
STACK_IMAGE=lmsysorg/sglang:nightly-cu134-20260909-708f51e
STACK_ASSET_NODES="100.97.87.120"  # 单节点:只查 S1

# --- 内存看门狗(make memwatch 从这里取,不再有 Makefile 的 ifeq 阶梯)-------
# ⚠️ WATCH_NODES 只给 S1:本栈是单节点,而 memwatch 的规则是「**任一**节点跌破
#    CRIT 就动手」。若把 S2 也列进来,别人在 S2 上跑别的东西就会停掉 S1 的主力栈
#    —— 两件毫不相干的事。2026-09-19 S2 空出来后立刻发现这条。
STACK_MEMWATCH_NODES="100.97.87.120"
STACK_MEMWATCH_STOP="./stop.sh"

# --- 客户端(qwen-model-switch.sh / codex 从这里取)--------------------------
STACK_CTXWIN=262144
STACK_CLIENT_ALIAS=sglang

STACK_BENCH=benchmarks/qwen38un-2026-09-19
