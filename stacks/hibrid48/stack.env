# Qwen3.8-Flash-Next hibrid48 —— bilikaz v4 配方,单节点,跑在 S2。
#
# 2026-09-28:顶替 fndgx(RadixArk)的对外身份(:18300 / qwen3.8-flash-next /
# 客户端别名 fndgx)。外部客户端零改动 —— 端口、模型名、thinking 语义
# (CoT 在 reasoning)、/v1/responses 全部实测过(见 STACK_BENCH 的 README)。
# fndgx 退役为可回滚备份(stacks/fndgx/stack.env.retired-2026-09-28;
# 回滚 = 改名还原 + 让出名字/别名 + 改 S2 recipe.yaml 回来)。
# A/B 数据(同题同协议,两臂 thinking ON):benchmarks/ab-radixark-vs-hibrid48-2026-09-28/
#   质量:四件套差 ≤2 题/200(噪声内);速度:中位数快 1.27–1.41×。
# "为什么是这些参数":recipe.yaml(上游 bilikaz/qwen38-flash-next-recipe v4 的副本)。

STACK_ID=hibrid48
STACK_NAME="Qwen3.8-Flash-Next NVFP4 单机 (bilikaz hibrid48, K=5 MTP)"
STACK_STATUS="S2 常驻 —— 与主力栈并跑 (2026-09-28 顶替 fndgx)"
STACK_ENGINE=vllm-hibrid48
STACK_RUNTIME=docker
STACK_NODES=1
STACK_HEAD=100.67.164.92
# 互斥按节点相交判:与 fndgx(若恢复)和 glm53(rank1 在 S2)全互斥,
# 与 qwen38un / qwen38(只在 S1)可并跑。
STACK_GPU_NODES="100.67.164.92"
STACK_PORT=18300
STACK_MODEL=qwen3.8-flash-next     # 对外 served 名(原 Qwen/Qwen3.8-Flash-Next,为保留 fndgx 的对外身份而改)

# --- thinking 语义(2026-09-28 全部对着活端点实测,记录在 benchmarks/ab-radixark-vs-hibrid48-2026-09-28/)
# ⚠️ 顶层 enable_thinking 在本引擎上被**静默忽略**(sheep 题实测:false 仍 72 reasoning tokens)。
#    关思考必须走 chat_template_kwargs(实测 0 reasoning tokens)。顶层字段在别的引擎
#    上有效、这里没有 —— 正是 gotcha #9 的形状。
STACK_THINK_KWARG=enable_thinking
STACK_THINK_OFF='{"chat_template_kwargs": {"enable_thinking": false}}'
STACK_COT_FIELD=reasoning          # reasoning_content 恒为 None(实测)
STACK_THINK_CAN_DISABLE=1
# 模板原生接受 low/medium/high/xhigh(reasons API 实测 high/xhigh 均 200);none 也过(无 reasoning item)。
# 不需要 fndgx 那种 EFFORT_ALIAS 改写 —— 那是 fndgx serve.sh 的怪癖,不是模板的。
STACK_EFFORT_KWARG=reasoning_effort
STACK_EFFORT_LEVELS="low medium xhigh"

# --- 运行时(adapter-docker.sh 读这些) ---
# 配方目录是上游自带布局,/home/admin/hibrid48-recipe 里 run.sh 读同目录 recipe.yaml。
STACK_DIR=/home/admin/hibrid48-recipe
STACK_CONTAINERS="qwen38-flash-next"
STACK_START_CMD="bash /home/admin/hibrid48-launch.sh"
STACK_STOP_CMD="cd /home/admin/hibrid48-recipe && ./stop.sh"
STACK_TMUX=1
STACK_LOAD_TIME="约 4-5 min (fastsafetensors,表 map 已缓存;全新机器首启多几分钟建 map)"

# --- 资产(preflight 用) ---
# 28 分片于 2026-09-27 从 HF snapshot hardlink 而来(105.34 GB,index 验证过)。
# S2 连不上 huggingface.co,run.sh 的下载路径未再验证;分片数变了 preflight 会拦。
STACK_WEIGHTS=/home/admin/hibrid48-recipe/models/Qwen3.8-Flash-Next-hibrid48
STACK_WEIGHTS_SHARDS=28
STACK_IMAGE=myllmbox/qwen38-flash-next-vllm:v4
STACK_ASSET_NODES="100.67.164.92"

# --- 内存看门狗 ---
# ⚠️ 只盯 S2。本栈不是主力栈,要自己的实例:make memwatch STACK=hibrid48(独立 tmux 会话)。
STACK_MEMWATCH_NODES="100.67.164.92"
# 停法必须是 STACK_DIR 下的脚本路径(mem-watch 启动自检会 test -x)
STACK_MEMWATCH_STOP="./stop.sh"

# --- 客户端 / 文档 ---
STACK_CLIENT_ALIAS=fndgx           # codex profile fndgx 就指到这个端点,名字不变
STACK_CTXWIN=262144
STACK_BENCH=benchmarks/ab-radixark-vs-hibrid48-2026-09-28
