# Mac 本地 omlx —— 不是本仓库部署的栈,只是客户端切换的一个目标。
# STACK_RUNTIME=external ⇒ 不参与 GPU 互斥,也没有 make run/stop 之类的生命周期动词;
# 存在的唯一理由是让 scripts/qwen-model-switch.sh 只有一个事实源。
STACK_ID=gemma
STACK_NAME="Gemma-4 26B QAT (Mac 本地 omlx)"
STACK_STATUS="local"
STACK_ENGINE=omlx
STACK_RUNTIME=external
STACK_NODES=0
STACK_HEAD=127.0.0.1
STACK_PORT=8000
STACK_MODEL=mlx-community__gemma-4-26B-A4B-it-qat-nvfp4
STACK_THINK_KWARG=enable_thinking
STACK_THINK_OFF='{"enable_thinking": false}'
STACK_COT_FIELD=reasoning_content
# ⚠️ 端口 8000 与 DGX 的两个 k3s 栈**同号**,区分点是主机名。2026-09-02 发现
#    全局 qwen 配置曾处于 baseUrl=127.0.0.1:8000(omlx)+ model=deepseek-v4-flash
#    (DGX 的模型)的自相矛盾状态 —— omlx 不提供那个模型,启动即 404。
STACK_CTXWIN=262144
STACK_CLIENT_ALIAS=gemma
