# DeepSeek-V4-Flash-0731 —— k3s, TP=2, jasl/vllm fork + DSpark 投机解码
STACK_ID=v4flash
STACK_NAME="DeepSeek-V4-Flash-0731 (DSpark n=5)"
STACK_STATUS="rollback #3"
STACK_ENGINE=vllm
STACK_RUNTIME=k3s
STACK_NODES=2
STACK_HEAD=100.97.87.120
STACK_PORT=8000
STACK_MODEL=deepseek-v4-flash

# ⚠️ 本栈关思考的 kwarg 是 `thinking`,不是 `enable_thinking` —— 2026-09-02
#    harness 照搬了这个名字去测 Flash-Next,服务端照常 200、CoT 一个字没关掉,
#    整个跨栈对照因此不成立(c96fcf3)。
STACK_THINK_KWARG=thinking
STACK_THINK_OFF='{"thinking": false}'
STACK_COT_FIELD=reasoning_content

STACK_NS=v4flash
STACK_LEADER=v4flash-leader
STACK_WORKER=v4flash-worker
STACK_DEPLOYS="v4flash-worker v4flash-leader"
STACK_LOAD_TIME="约 5 分钟(167 GB 权重)"
STACK_NODES_IPS="100.97.87.120 100.67.164.92"

STACK_WEIGHTS=/home/admin/models/DeepSeek-V4-Flash-0731
STACK_IMAGE=vllm-node-dsv4
STACK_ASSET_NODES="100.97.87.120 100.67.164.92"

STACK_MEMWATCH_NODES="100.97.87.120 100.67.164.92"

# ⚠️ 1000000 不是"大方",是必需:Qwen Code 对 `deepseek-v4*` 预留 384000 输出
#    token,低于 ~384k 的值会把硬阈值钳到 0,**每一个请求**都报 "hard limit: 0"。
STACK_CTXWIN=1000000
STACK_CLIENT_ALIAS=v4flash
STACK_BENCH=benchmarks/bench-full-2026-08-05
