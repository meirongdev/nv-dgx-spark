# Qwen3.8-Flash-Next NVFP4 —— **单节点**,跑在 S2 上(blazux/qwen3.8-Flash-DGX)
#
# 本仓库第一个「与主力栈并跑」的栈:S1 跑 qwen38un,S2 跑本栈,两个独立端点。
# 能并跑是因为 preflight 的互斥在 2026-09-20 从「全表互斥」改成了「按节点相交」
# (stacks/_lib/common.sh 的 stack_gpu_nodes)。
#
# ⚠️ 它和 qwen38fn **是同一个模型**,但不是同一个栈:qwen38fn 是 TP=2 两台机器,
#    本栈把 48 GiB 的 PLE n-gram 表用 mmap 从 NVMe 上读,于是一台机器就装得下。
#    代价是单流解码只有一半左右(见 recipe.yaml 的实测对照)。
# 「为什么是这些参数」在 recipe.yaml 里,不在这里。

STACK_ID=fndgx
STACK_NAME="Qwen3.8-Flash-Next NVFP4 单机 (PLE mmap + hybrid)"
STACK_STATUS="S2 常驻 —— 与主力栈并跑"
STACK_ENGINE=vllm-ple-mmap
STACK_RUNTIME=docker
STACK_NODES=1
STACK_HEAD=100.67.164.92           # ⚠️ 唯一一个 head 不是 S1 的栈
# 本栈吃哪些节点的 GPU 内存 —— preflight 互斥的判据。只占 S2,所以它与 S1 上的
# qwen38un/qwen38 可以并存;但三个 TP=2 栈的 rank1/worker 都在 S2,与本栈互斥。
STACK_GPU_NODES="100.67.164.92"
STACK_PORT=18300                   # 上游默认端口,与本仓库任何栈都不重号
STACK_MODEL=qwen3.8-flash-next     # served-model-name = 栈的真正身份

# --- 思考语义:**第六套**。以下三行全部是 2026-09-20 对着活端点实测出来的,
#     不是从 qwen38fn 抄的 —— 抄的话两行都是错的(gotcha #9)。
#
# ⚠️ CoT 回在 `reasoning`,**不是** `reasoning_content`:后者实测恒为 None。
#    同一个模型,qwen38fn(官方镜像)那栈记的是 reasoning_content —— 差别来自
#    引擎构建/parser 版本,不是模型。读错字段的表现是「一个字都没有」,
#    与「思考压根没生效」完全同形。
# ⚠️ `thinking: false`(v4flash 的写法)在本栈被**静默忽略**:HTTP 200、CoT
#    一字未减(实测 194 字,与基线一模一样)。
STACK_THINK_KWARG=enable_thinking
STACK_THINK_OFF='{"enable_thinking": false}'
STACK_COT_FIELD=reasoning
# 实测 enable_thinking=false 是**真关**:同一道题 102 → 3 个输出 token,
# reasoning 从 299 字变 None。代价也是真的:答案从对的 22 变成错的 13。
STACK_THINK_CAN_DISABLE=1
# 第二个旋钮(本栈独有):reasoning_effort。模板档位 low/medium/xhigh,不传即 xhigh。
# 顶层 reasoning_effort 也收,因为 serve.sh 的 EFFORT_ALIAS=1 把 high/max→xhigh、
# minimal→low 改写进了模板副本 —— 没有它,codex/Claude Code 的 "high" 会 400。
STACK_EFFORT_KWARG=reasoning_effort
STACK_EFFORT_LEVELS="low medium xhigh"

# --- 运行时(docker 适配器读这几行)-----------------------------------------
STACK_DIR=/home/admin/qwen38-flash-dgx
STACK_CONTAINERS="qwen38-flash"
STACK_START_CMD="bash /home/admin/fndgx-launch.sh"   # ← stacks/fndgx/launch.sh,由适配器 scp
# ⚠️ 停机走上游自己的动词 `./flash rm`(= docker rm -f),不是裸 docker 命令。
#    两个理由,第二个是踩出来的:
#    1. `./flash stop` 是 docker stop -t 30,优雅但最多等 30 秒 —— 看门狗动手时
#       是在抢 OOM,等不起。`rm` 立刻释放。
#    2. mem-watch.sh 的启动自检做的是 `cd $STACK_DIR && test -x <停机命令的第一个词>`,
#       所以停机动作**必须是 STACK_DIR 下的一个可执行文件**。写成裸 `docker rm -f X`
#       的话自检会判 `$STACK_DIR/docker` 不存在,看门狗 exit 3 根本不启动 ——
#       2026-09-20 实测,qwen38 那栈至今就是这个状态。
STACK_STOP_CMD="cd /home/admin/qwen38-flash-dgx && ./flash rm"
STACK_TMUX=1                       # 启动要几分钟,SSH 走 DERP 会掉线
STACK_LOAD_TIME="约 5 分钟(页缓存冷时 8-13 分钟)"

# --- 资产(preflight 用)-----------------------------------------------------
# ⚠️ 指的是 **-fp8hybrid** 那份布局,不是原始快照 —— 引擎实际加载的是它。
#    206 个 *.safetensors 里只有 4 个是真文件(转成 blockwise fp8 的侧层),
#    其余 202 个是指回原快照的相对符号链接,所以只多占 13 GiB。
STACK_WEIGHTS=/home/admin/.cache/huggingface/hub/models--RadixArk--Qwen3.8-Flash-Next-NVFP4/snapshots/7b719225242aacd3dbd3f9407468c2ee9a9d2594-fp8hybrid
STACK_WEIGHTS_SHARDS=206
STACK_IMAGE=qwen38-flash-dgx
STACK_ASSET_NODES="100.67.164.92"  # 单节点:只查 S2

# --- 内存看门狗 --------------------------------------------------------------
# ⚠️ 只盯 S2。把 S1 列进来的话,S1 主力栈正常吃内存就会停掉 S2 上的本栈 ——
#    两件毫不相干的事(qwen38un 的 stack.env 里记着同一条教训的另一半)。
# ⚠️ 本栈需要**自己的一份** memwatch 实例:make memwatch STACK=fndgx。
#    看门狗默认只守 stacks/PRIMARY,而本栈不是主力栈 —— 不显式起,它没人守。
STACK_MEMWATCH_NODES="100.67.164.92"
STACK_MEMWATCH_STOP="./flash rm"   # 相对 STACK_DIR,且必须可执行 —— 见上面 STACK_STOP_CMD 的注释

# --- 客户端 ------------------------------------------------------------------
# 2026-09-20 从 500000(YaRN factor=4)降回**原生 262144**,走上游的 native profile。
# ⚠️ 降它**没有**换来更大的 KV 池 —— 池子由「权重和激活之后还剩多少显存」决定,
#    不是由 max-model-len 决定:496,770 tokens vs 之前的 500,000,基本没动。
#    真正变的是 maximum concurrency:1.00x → **1.90x**(同一个池子,请求短了一半)。
STACK_CTXWIN=262144
STACK_CLIENT_ALIAS=fndgx
STACK_BENCH=benchmarks/fndgx-2026-09-20
