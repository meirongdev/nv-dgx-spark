# Qwen3.8-Flash-Next hibrid48 —— myllmbox 双机 cluster kit **v5.2**,TP=2 横跨 S1+S2。
#
# ⚠️ 2026-10-22 23:40 起为**主力栈**(A/B 之后同日升任),接手 hibrid48tp2 的 served 名
#    qwen3.8-flash-next-tp2 与别名 fntp2 —— 端点、名字、端口全不变,客户端零改动。
#
# 2026-10-22 新增时是 A/B 候选:与 hibrid48tp2(kit v4.1)同一份 hibrid48
# checkpoint(两台都是 hibrid48tp2 那份的 hardlink,零下载),只换 kit + 镜像:
# myllmbox/qwen38-flash-next-cluster-recipe @ v5.2 (250c098 → d2721ec),镜像
# myllmbox/qwen38-flash-next-cluster-vllm:v5.2(vLLM 0.30 + RecoverSSM、K≤7 动态草稿深度
# 进 full CUDA graph、one-shot RoCE all-reduce、GB10 skinny-GEMM)。
# 上游 v5.2 的默认 checkpoint 是 INT4-AutoRound(~122G,需下载);上游把 hibrid48 列为
# 同镜像的一行注释("~10 % slower"),本栈先测这一行 —— 单变量 A/B。
# "为什么是这些参数":recipe.yaml。
#
# ⚠️ 与 hibrid48tp2 同为 TP=2、同一 head、同一容器名(qwen38-flash-next-cluster):
#    两者互斥(preflight 按节点相交 + 容器名都能拦住),而且 memwatch-hibrid48tp2 的
#    ./stop.sh 按容器名停,测试期间一样能停掉本栈。
# ⚠️ TP=2 的全部规矩适用:绝不单独重启一个 rank(gotcha #1)。

STACK_ID=hibrid48tp2v52
STACK_NAME="Qwen3.8-Flash-Next hibrid48 双机 TP=2 (myllmbox cluster kit v5.2, K≤7 动态 MTP)"
STACK_STATUS="rollback (kit v5.2) —— 2026-11-14 让位给 dsv41"
STACK_ENGINE=vllm-hibrid48-cluster-v52
STACK_RUNTIME=docker
STACK_NODES=2
STACK_HEAD=100.97.87.120
# ⚠️ TP=2:rank1 吃 S2 的 GPU —— 两台都要写(gotcha #2)。
STACK_GPU_NODES="100.97.87.120 100.67.164.92"
STACK_PORT=8000
# served 名全局唯一。A/B 期间是 qwen3.8-flash-next-tp2-v52;升主力时与 hibrid48tp2 对调,
# 于是 codex dgx / Qwen Code / LiteLLM / calibre-metadata 一个都不用改。
STACK_MODEL=qwen3.8-flash-next-tp2

# --- thinking 语义(2026-10-22 对着活端点实测;make test STACK=hibrid48tp2v52 全过) ---
# 与 hibrid48tp2 完全相同:只有 chat_template_kwargs.enable_thinking 生效(on 72 / off 0
# reasoning tokens),顶层 enable_thinking 被静默忽略(66 tokens);CoT 在 `reasoning`。
# /v1/responses effort:none / low / medium / xhigh → 200;minimal / high / max → 400。
STACK_THINK_KWARG=enable_thinking
STACK_THINK_OFF='{"chat_template_kwargs": {"enable_thinking": false}}'
STACK_COT_FIELD=reasoning
STACK_THINK_CAN_DISABLE=1
STACK_EFFORT_KWARG=reasoning_effort
STACK_EFFORT_LEVELS="low medium xhigh"

# --- 运行时(adapter-docker.sh 读这些) ---
# 上游 v5.2 kit 原样放在 S1 的 /home/admin/hibrid48tp2v52-recipe;cluster.env 抄
# hibrid48tp2 那份手写的(格式 v4.1 → v5.2 未变)。
# ib_links: 2(双轨)在这两台上会自动退回单轨:第二个 RDMA 半口 roceP2p1s0f0 是 ACTIVE,
# 但 enP2p1s0f0np0 没有 IPv4(2026-10-22 查)—— 所以本 A/B 只换 kit/引擎,不含双轨。
STACK_DIR=/home/admin/hibrid48tp2v52-recipe
STACK_CONTAINERS="qwen38-flash-next-cluster"
STACK_WORKER_CONTAINER=qwen38-flash-next-cluster
STACK_WORKER_IP=192.168.200.102
STACK_START_CMD="bash /home/admin/hibrid48tp2v52-launch.sh"
STACK_STOP_CMD="cd /home/admin/hibrid48tp2v52-recipe && ./stop.sh"
STACK_TMUX=1
STACK_LOAD_TIME="约 5.5 min(权重 ~112 s + init engine 109 s,其中 graph capture 42 s / 7.80 GiB;2026-10-22 实测)"

# --- 资产(preflight 用;两台都查) ---
# 与 hibrid48tp2 同 28 分片(hardlink:cp -al,同一文件系统,零额外磁盘)。kit 要求
# 两台**同一绝对路径**,且 models/<name> 必须是真目录(容器里跟不了 symlink)。
STACK_WEIGHTS=/home/admin/hibrid48tp2v52-recipe/models/Qwen3.8-Flash-Next-hibrid48
STACK_WEIGHTS_SHARDS=28
# 镜像:registry manifest digest sha256:697d4364…(= 上游 v5.2 README)。67 层里前 37 层
# 与两台已有镜像同前缀,缺 30 层共 43.7 MB。
STACK_IMAGE=myllmbox/qwen38-flash-next-cluster-vllm:v5.2
STACK_ASSET_NODES="100.67.164.92 100.97.87.120"

# --- 内存看门狗 ---
# 实测余量(2026-10-22,MemAvailable):boot S1 13.71 GiB (11.3%) / S2 16.90 (13.9%);
#   跑完 c1→c64 梯子 + 8K/32K/128K 冷 prefill 后 S1 10.0% / S2 12.6%,128K 期间 S1 最低 12.16 GiB。
#   比 v4.1 开机多 1.5~2 GiB(KV 33G vs 41G,graph 多吃 7.8 GiB)。这是 ~10 分钟的 steady,
#   不是天级的 —— 阈值先沿用 hibrid48tp2 的:
#   (benchmarks/hibrid48tp2v52-2026-10-22/README.md)
#   WATCH_WARN_PCT=5 WATCH_CRIT_PCT=2 WATCH_CRIT_CONSEC=10 make memwatch STACK=hibrid48tp2v52
STACK_MEMWATCH_NODES="100.67.164.92 100.97.87.120"
STACK_MEMWATCH_STOP="./stop.sh"
# 阈值进注册表(2026-10-27):原先只在上面的注释和 tmux 命令行里,驻留节点的 systemd
# 服务没有命令行可抄。WATCH_* 环境变量仍优先。
STACK_MEMWATCH_WARN_PCT=5
STACK_MEMWATCH_CRIT_PCT=2
STACK_MEMWATCH_CRIT_CONSEC=10

# --- 客户端 / 文档 ---
STACK_CLIENT_ALIAS=fntp2
STACK_CTXWIN=262144
STACK_BENCH=benchmarks/hibrid48tp2v52-2026-10-22
