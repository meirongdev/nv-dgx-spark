# Qwen3.8-27B-NVFP4(原版/有审核)—— S1 单机裸 docker,无投机解码
# 存在的理由:两个 TP=2 栈都是不可分的,一台机器死了整个服务就死
# (2026-08-15 S2 硬件死亡)。它**更慢也更弱**,是降级不是升级。
STACK_ID=qwen38
STACK_NAME="Qwen3.8-27B-NVFP4 (censored, no speculator)"
STACK_STATUS="retired-ish —— 24.9 tok/s"
STACK_ENGINE=vllm
STACK_RUNTIME=docker
STACK_NODES=1
STACK_HEAD=100.97.87.120
STACK_PORT=8888
STACK_MODEL=qwen38-27b

STACK_THINK_KWARG=enable_thinking
STACK_THINK_OFF='{"enable_thinking": false}'
STACK_COT_FIELD=reasoning_content

STACK_DIR=/home/admin
STACK_CONTAINERS="qwen38-27b"
STACK_START_CMD="bash /home/admin/qwen38-launch.sh"   # ← stacks/qwen38/launch.sh
STACK_STOP_CMD="docker rm -f qwen38-27b 2>/dev/null; echo stopped; free -h | head -2"
STACK_TMUX=0               # 裸 docker run -d,秒级返回,不需要 tmux
STACK_LOAD_TIME="约 220 秒(22 GB 权重)"

STACK_WEIGHTS=/home/admin/models/Qwen3.8-27B-NVFP4
STACK_IMAGE=vllm/vllm-openai:nightly-aarch64
STACK_ASSET_NODES="100.97.87.120"

STACK_MEMWATCH_NODES="100.97.87.120"
STACK_MEMWATCH_STOP="docker rm -f qwen38-27b"

STACK_CTXWIN=262144        # 原生 262144;YaRN 扩到 1M 的方案 2026-08-15 已否决
STACK_CLIENT_ALIAS=qwen38
STACK_BENCH=
