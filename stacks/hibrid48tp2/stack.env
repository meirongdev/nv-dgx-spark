# Qwen3.8-Flash-Next hibrid48 —— myllmbox 双机 cluster 配方,TP=2 横跨 S1+S2。
#
# ⚠️ 2026-10-22 起退为回滚栈(kit v4.1):主力换成 hibrid48tp2v52(同权重,kit v5.2),
#    served 名 qwen3.8-flash-next-tp2 与别名 fntp2 一并移交过去,本栈改名 …-v41 / fntp2v41。
#    A/B:benchmarks/hibrid48tp2v52-2026-10-22/。
#
# 2026-09-30 → 10-22 为主力栈:同一份 hibrid48 checkpoint(与 S2 单机栈逐字节同源,HF
# 修订 e316057d),换成上游双机 kit(myllmbox/qwen38-flash-next-cluster-recipe @
# 4e4747b,v4.1)。同测法实测(benchmarks/hibrid48tp2-2026-09-30/):单流 ~98.9 tok/s
# (上游 99),c64 562 聚合 —— 对 hibrid48 单机 72.3 / 200.1、qwen38un 42 / 216.9。
# 启动不变量与上游逐字相同:KV 池 2,450,356 token、每 rank 权重 51.03 GiB。
# "为什么是这些参数":recipe.yaml。
#
# ⚠️ 占两台机器的 GPU:起它之前 qwen38un(S1)和 hibrid48(S2)都必须停 ——
#    preflight 会按节点相交拦住。它是 glm53 之外第二个多节点栈。
# ⚠️ TP=2 的全部规矩重新适用:绝不单独重启一个 rank(gotcha #1),
#    ./stop.sh 成对停,make restart 是唯一安全路径。

STACK_ID=hibrid48tp2
STACK_NAME="Qwen3.8-Flash-Next NVFP4 双机 TP=2 (myllmbox cluster hibrid48, K=5 MTP)"
STACK_STATUS="rollback (kit v4.1) —— 2026-10-22 让位给 hibrid48tp2v52"
STACK_ENGINE=vllm-hibrid48-cluster
STACK_RUNTIME=docker
STACK_NODES=2
# head = S1(已清理 ZCode 进程,内存释放后承载 head)。
# rank1(--headless)在 S2。
STACK_HEAD=100.97.87.120
# ⚠️ TP=2:rank1 在 S1 上同样吃满 GPU 内存 —— 两台都要写(gotcha #2)。
#    用 Tailscale 侧地址,与其它栈的节点集合写法一致,否则互斥静默失效。
STACK_GPU_NODES="100.97.87.120 100.67.164.92"
STACK_PORT=8000
# served 名全局唯一(注册表硬约束):qwen3.8-flash-next 已归 hibrid48;
# qwen3.8-flash-next-tp2 自 2026-10-22 起归主力 hibrid48tp2v52(客户端零改动),本栈加 -v41。
# ⚠️ 所以回滚到本栈时客户端要跟着改名 —— 或者把两个栈的 served 名再换回来。
STACK_MODEL=qwen3.8-flash-next-tp2-v41

# --- thinking 语义(2026-09-30 对着活端点实测;make test STACK=hibrid48tp2 断言) ---
# chat_template_kwargs.enable_thinking 真能开/关(sheep 题:on 72 reasoning tokens 答 22,
# off 0 tokens 答 13);**顶层 enable_thinking 被静默忽略**(false 仍 66 tokens)——
# 与 hibrid48 单机同形。CoT 在 `reasoning`,`reasoning_content` 不出现。
STACK_THINK_KWARG=enable_thinking
STACK_THINK_OFF='{"chat_template_kwargs": {"enable_thinking": false}}'
STACK_COT_FIELD=reasoning
STACK_THINK_CAN_DISABLE=1
# /v1/responses 的 effort(每档实发一次看 HTTP 码):
#   none / low / medium / xhigh → 200(none 真无 reasoning item,0 reasoning tokens)
#   minimal / high / max        → 400 "Supported types are xhigh (default), medium, and low."
# ⚠️ 与 hibrid48 单机**不同**:那边记的是 high 也 200。同一 checkpoint、换了引擎构建,
#    档位集合就变了 —— 又一例 gotcha #9。codex catalog 只能列这四档。
STACK_EFFORT_KWARG=reasoning_effort
STACK_EFFORT_LEVELS="low medium xhigh"

# --- 运行时(adapter-docker.sh 读这些) ---
# 上游 kit 布局原样放在 S2 的 /home/admin/hibrid48tp2-recipe:run.sh 读同目录
# recipe.yaml(模型侧)+ cluster.env(两台机器侧)。cluster.env 是**手写**的,没跑
# 交互式 setup.sh —— 它会把 10.14.20.x 局域网也当成候选互联并停下来问;手写值:
#   HEAD_IC=192.168.200.102 HEAD_IFACE=enp1s0f0np0 HEAD_HCA=rocep1s0f0
#   WORKER_HOST=192.168.200.101 WORKER_USER=admin
#   WORKER_IC=192.168.200.101 WORKER_IFACE=enp1s0f0np0 WORKER_HCA=rocep1s0f0
# NCCL_IB_GID_INDEX 不写死:run.sh 每次启动按两台的活 GID 表现探(它会随 link flap 变)。
# run.sh 顺序:两台拉镜像(no-op 或回落 inspect)→ 权重在否 → 两台内存 ≥100G →
#   清本 checkpoint 的 page cache → 先起 head(rank0)再起 worker(rank1)→ 等 /health。
STACK_DIR=/home/admin/hibrid48tp2-recipe
STACK_CONTAINERS="qwen38-flash-next-cluster"
STACK_WORKER_CONTAINER=qwen38-flash-next-cluster
STACK_WORKER_IP=192.168.200.102    # 200G 内网线,从 head(S1)跳到 rank1(S2)看日志
STACK_START_CMD="bash /home/admin/hibrid48tp2-launch.sh"
STACK_STOP_CMD="cd /home/admin/hibrid48tp2-recipe && ./stop.sh"
STACK_TMUX=1
STACK_LOAD_TIME="约 4-5 min(fastsafetensors ~97 s + profile/KV/graph ~67 s;首启多 FlashInfer JIT)"

# --- 资产(preflight 用;两台都查) ---
# 28 分片 = 19 model + 1 lmhead + 8 ple,105,336,540,328 字节,与 HF 修订 e316057d
# 的大小逐个一致(2026-09-30 核);S2 上是 hibrid48 那份的 hardlink(cp -al,零额外
# 磁盘),S1 上是经 200G 内网 rsync 的实拷贝。两台**同一绝对路径**是 kit 的硬要求。
STACK_WEIGHTS=/home/admin/hibrid48tp2-recipe/models/Qwen3.8-Flash-Next-hibrid48
STACK_WEIGHTS_SHARDS=28
# 镜像:digest(arm64 config)sha256:4d03fc80…,属于上游 README 的 index 861ac752…。
# ⚠️ 国内镜像站拉不下来(1ms.run 给 manifest,blob 重定向 Cloudflare 被 reset;
#    daocloud 白名单拒)。实际做法:37/40 层与 S2 上单机镜像 :v4 同前缀,只取 3 个新层
#    (S1 的 xray 代理,~36 MB)+ config 组部分归档 docker load,再 save|load 到 S1。
STACK_IMAGE=myllmbox/qwen38-flash-next-cluster-vllm:v6
STACK_ASSET_NODES="100.67.164.92 100.97.87.120"

# --- 内存看门狗 ---
# ⚠️ 两台都要盯:rank1 在 S1 上 OOM 一样冻住一台没有 BMC 的机器。
#    停法必须成对停 head+worker —— kit 的 ./stop.sh 正是(本机 docker rm + ssh worker)。
# 实测余量(MemAvailable):boot S2 10.5% / S1 12.0%;跑完 c1→c64 梯子后 S2 9.7% /
#   S1 11.1% —— 上游说 head 只剩 ~6G,本仓库量到 11.8 GiB(其中 ~10 GiB 是可回收的
#   page cache,MemFree 只有 ~1.3 GiB)。steady 离默认 warn 8% 太近,所以:
#   WATCH_WARN_PCT=5 WATCH_CRIT_PCT=2 WATCH_CRIT_CONSEC=10 make memwatch STACK=hibrid48tp2
#   (crit 2% ≈ 2.4 GiB 持续 100 s 才动手 —— 比 hibrid48 单机的 1% 保守,防 page cache 抖动误杀)。
#   ⚠️ boot ≠ steady(qwen38un 0.85 两小时从 9.4% 掉到 5.0%);这是 ~15 分钟的 steady,不是两小时的。
#   ⚠️ 长 prefill 会临时再吃 ~4 GiB:137K token 的冷 prefill 期间 S2 最低 8.03 GiB(~6.6%)。
#      256K 没测过 —— 按这个斜率会逼近 warn 5%,真要喂 256K 时盯着 memwatch。
STACK_MEMWATCH_NODES="100.67.164.92 100.97.87.120"
STACK_MEMWATCH_STOP="./stop.sh"
# 阈值见上方注释(2026-10-27 起进注册表;WATCH_* 环境变量仍优先)。
STACK_MEMWATCH_WARN_PCT=5
STACK_MEMWATCH_CRIT_PCT=2
STACK_MEMWATCH_CRIT_CONSEC=10

# --- 客户端 / 文档 ---
STACK_CLIENT_ALIAS=fntp2v41
STACK_CTXWIN=262144
STACK_BENCH=benchmarks/hibrid48tp2-2026-09-30
