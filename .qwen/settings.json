{
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "model": {
    "name": "deepseek-v4-flash",
    "generationConfig": {
      "timeout": 300000,
      "maxRetries": 8,
      "contextWindowSize": 1000000
    }
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(medium.com)",
      "WebFetch(forums.developer.nvidia.com)",
      "WebFetch(hackernoon.com)",
      "WebFetch(sourceit.com.sg)",
      "WebFetch(github.com)",
      "Bash(mkdir *)",
      "Bash(make *)",
      "Bash(uv *)",
      "Bash(ssh *)",
      "Bash(curl *)",
      "Bash(python3 *)",
      "Bash(time *)",
      "WebFetch(www.reddit.com)",
      "Bash(sshpass *)",
      "Bash(ping *)",
      "Bash(grep *)",
      "Bash(tr *)",
      "Bash(chmod *)",
      "Bash(bash *)",
      "WebFetch(vllm.hyper.ai)",
      "WebFetch(www.cnblogs.com)",
      "Bash(scp *)",
      "Bash(sleep *)",
      "Bash(ls *)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Bash(git commit *)",
      "Bash(git reset *)",
      "Bash(ansible *)",
      "Bash(docker run *)",
      "Bash(docker search *)",
      "Bash(nc *)",
      "Bash(timeout *)",
      "Bash(/bin/ls *)",
      "Bash(cat *)"
