# aider polyglot benchmark image, adapted for aarch64 + mainland-China network.
#
# Deltas from upstream benchmark/Dockerfile:
#   1. deadsnakes PPA + python3.11 dropped. aider needs >=3.10,<3.15 and jammy
#      ships 3.10, so the PPA bought nothing and was the single riskiest step
#      (launchpad.net is slow/blocked from CN and arm64 PPA coverage is uneven).
#   2. apt -> Tsinghua ubuntu-ports (arm64 lives on ports.ubuntu.com, not archive).
#   3. Go   -> mirrors.aliyun.com  (golang.org is blocked in CN).
#   4. Rust -> Tsinghua rustup mirror.
#   5. Node -> Tsinghua nodejs-release tarball instead of deb.nodesource.com.
#   6. npm  -> registry.npmmirror.com;  pip -> Tsinghua PyPI.
#   7. Base buildpack-deps:jammy -> ubuntu:22.04. daocloud served buildpack-deps
#      at 39 KB/s (14h for 2GB); ubuntu:22.04 was already local from the earlier
#      SWE-bench work. buildpack-deps is just ubuntu + build tools + dev headers,
#      so we install that set below from the Tsinghua mirror instead.
FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# --- apt via Tsinghua ubuntu-ports (arm64) ---------------------------------
# http:// on purpose: the bare ubuntu:22.04 image ships no ca-certificates, so an
# https:// mirror fails TLS before we can install them. apt authenticates by GPG
# signature regardless of transport, so http here is safe, not a shortcut.
RUN sed -i -e 's|http://ports.ubuntu.com/ubuntu-ports|http://mirrors.tuna.tsinghua.edu.cn/ubuntu-ports|g' \
           -e 's|http://archive.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' \
           -e 's|http://security.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' \
        /etc/apt/sources.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        wget \
        git \
        ca-certificates \
        pkg-config \
        libssl-dev \
        zlib1g-dev \
        unzip \
        cmake \
        libboost-all-dev \
        libtbb-dev \
        python3 \
        python3-venv \
        python3-dev \
        python3-pip \
        ca-certificates-java \
        openjdk-21-jdk \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# --- Go (arch-detected, aliyun mirror) -------------------------------------
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then GOARCH="amd64"; \
    elif [ "$ARCH" = "aarch64" ]; then GOARCH="arm64"; \
    else false; fi && \
    curl -fsSL "https://mirrors.aliyun.com/golang/go1.21.5.linux-$GOARCH.tar.gz" -o go.tar.gz && \
    tar -C /usr/local -xzf go.tar.gz && rm go.tar.gz
ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOPROXY=https://goproxy.cn,direct

# --- Rust (Tsinghua rustup + crates mirror) --------------------------------
ENV RUSTUP_DIST_SERVER=https://mirrors.tuna.tsinghua.edu.cn/rustup
ENV RUSTUP_UPDATE_ROOT=https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup
RUN ARCH=$(uname -m) && \
    curl -fsSL "https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup/dist/${ARCH}-unknown-linux-gnu/rustup-init" \
        -o /tmp/rustup-init && \
    chmod +x /tmp/rustup-init && /tmp/rustup-init -y --no-modify-path && rm /tmp/rustup-init
ENV PATH="/root/.cargo/bin:${PATH}"
RUN printf '[source.crates-io]\nreplace-with = "tuna"\n\n[source.tuna]\nregistry = "sparse+https://mirrors.tuna.tsinghua.edu.cn/crates.io-index/"\n' \
        > /root/.cargo/config.toml

# --- Node (Tsinghua tarball) + jest toolchain ------------------------------
ENV NODE_VERSION=20.18.0
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then NARCH="x64"; \
    elif [ "$ARCH" = "aarch64" ]; then NARCH="arm64"; \
    else false; fi && \
    curl -fsSL "https://mirrors.tuna.tsinghua.edu.cn/nodejs-release/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NARCH}.tar.xz" -o node.tar.xz && \
    tar -C /usr/local --strip-components=1 -xJf node.tar.xz && rm node.tar.xz
RUN npm config set registry https://registry.npmmirror.com && \
    mkdir -p /npm-install && cd /npm-install && npm init -y && \
    npm install \
    jest \
    @babel/core@7.25.2 \
    @exercism/babel-preset-javascript@0.2.1 \
    @exercism/eslint-config-javascript@0.6.0 \
    @types/jest@29.5.12 \
    @types/node@20.12.12 \
    babel-jest@29.6.4 \
    core-js@3.37.1 \
    eslint@8.49.0

# --- aider itself (Tsinghua PyPI) ------------------------------------------
# ~/.docker/config.json forces every build through the xray proxy
# (http://172.17.0.1:10809), which tunnels abroad: measured 18 KB/s inside the
# build vs 34.7 MB/s from the host straight to the same Tsinghua mirror.
# --build-arg http_proxy= cleared it for apt but not for uv's HTTPS, so unset it
# here as well. Every source in this file is domestic, so nothing needs a proxy.
# Placed just before the pip steps to keep the Go/Rust/Node layers cached.
ENV http_proxy="" https_proxy="" HTTP_PROXY="" HTTPS_PROXY="" \
    no_proxy="*" NO_PROXY="*"
ENV PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# aider's build backend derives its version from git via setuptools_scm. We
# fetched a codeload tarball (github.com itself is blocked here; only codeload
# responds), so there is no .git and the build aborts. Pin the version the
# source declares in aider/__init__.py instead of adding a git dependency.
ENV SETUPTOOLS_SCM_PRETEND_VERSION_FOR_AIDER_CHAT=0.86.3.dev0
COPY . /aider
RUN pip3 install --no-cache-dir --upgrade pip uv
# NOT `-e /aider[dev]`. On Python 3.10 that extra is unsatisfiable: the [dev]
# constraint set pins numpy==2.4.3 (needs >=3.11) while base aider requires
# numpy<2 for python<3.11. Upstream dodges this by installing python3.11 from
# the deadsnakes PPA -- which is unreachable/uncertain-on-arm64 from here, so we
# install base aider (resolves numpy<2 correctly) plus only the four extra
# packages benchmark/benchmark.py actually imports.
RUN uv pip install --system --no-cache-dir -e /aider
RUN uv pip install --system --no-cache-dir lox pandas matplotlib typer imgcat
RUN git config --global --add safe.directory /aider
WORKDIR /aider
